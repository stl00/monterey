# Copy to .env and fill in. Never commit .env.

PORTFOLIO_SOURCES=schwab,okx,futu
PORTFOLIO_BASE_CCY=HKD
PORTFOLIO_DATA_DIR=data

# Schwab: developer.schwab.com -> app with "Accounts and Trading Production"
SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
# Must match the callback URL registered on the Schwab app exactly
SCHWAB_REDIRECT_URI=https://127.0.0.1

# OKX: API key with Read permission only (no Trade, no Withdraw)
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_BASE_URL=https://www.okx.com

# Futu: OpenD running and logged in
FUTU_OPEND_HOST=127.0.0.1
FUTU_OPEND_PORT=11111
FUTU_SECURITY_FIRM=FUTUSECURITIES
